# Copy to .env and fill in real values. .env is never committed.
# Use a DIFFERENT strong random password for each role (e.g. openssl rand -hex 20). Dev only.
DB_NAME=swiftdrop_auth
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/swiftdrop_auth

# Superuser: used only by Docker to create the database and roles
DB_ADMIN_USER=postgres_admin
DB_ADMIN_PASSWORD=change-me

# Schema owner: used only by Flyway to run migrations
DB_MIGRATOR_USER=identity_migrator
DB_MIGRATOR_PASSWORD=change-me

# Application: rows only (SELECT/INSERT/UPDATE/DELETE)
DB_APP_USER=identity_app
DB_APP_PASSWORD=change-me
